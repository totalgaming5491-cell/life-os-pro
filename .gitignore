* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  background: #0b0b14;
  color: white;
  padding: 18px;
}

.container {
  max-width: 650px;
  margin: auto;
}

header {
  padding: 25px 5px;
  text-align: center;
}

header h1 {
  font-size: 30px;
  color: #a78bfa;
}

header p {
  color: #aaa;
  margin-top: 10px;
}

.dashboard {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 20px 0;
}

.card {
  background: #191927;
  padding: 18px;
  border-radius: 15px;
  border: 1px solid #292940;
  margin: 12px 0;
}

.card h3 {
  margin-bottom: 10px;
}

.card p {
  color: #aaa;
  font-size: 13px;
}

section {
  margin-top: 35px;
}

section h2 {
  color: #a78bfa;
  margin-bottom: 15px;
}

input, select {
  width: 100%;
  padding: 13px;
  margin: 8px 0;
  border-radius: 9px;
  border: 1px solid #393951;
  background: #10101d;
  color: white;
}

button {
  background: #8b5cf6;
  color: white;
  border: none;
  padding: 12px 16px;
  border-radius: 9px;
  margin: 5px 3px;
  cursor: pointer;
}

button:active {
  transform: scale(.97);
}

label {
  display: flex;
  align-items: center;
  gap: 8px;
}

label input {
  width: auto;
}

@media (max-width: 400px) {
  .dashboard {
    grid-template-columns: 1fr;
  }
}
